#include <Wire.h>

const uint8_t  ADDR      = 0x68;
const uint32_t PERIOD_US = 10000;
const int      CAL_N     = 500;
const float    ALPHA     = 0.1f;

const float ACC_LSB  = 16384.0f;
const float GYRO_LSB = 131.0f;

float bias[7] = {0};
float filt[7] = {0};
bool  seeded  = false;
elapsedMicros tick;

void writeReg(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

uint8_t readReg(uint8_t reg) {
  Wire.beginTransmission(ADDR);
  Wire.write(reg);
  Wire.endTransmission(false);
  if (Wire.requestFrom(ADDR, (uint8_t)1) != 1) return 0xFF;
  return Wire.read();
}

bool readRaw(int16_t v[7]) {
  Wire.beginTransmission(ADDR);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom(ADDR, (uint8_t)14) != 14) return false;
  for (int i = 0; i < 7; i++) {
    uint8_t hi = Wire.read();
    uint8_t lo = Wire.read();
    v[i] = (int16_t)((hi << 8) | lo);
  }
  return true;
}

void calibrate() {
  Serial.println("Calibrating, keep still...");
  double sum[7] = {0};
  int good = 0;
  for (int n = 0; n < CAL_N; n++) {
    int16_t v[7];
    if (readRaw(v)) {
      for (int i = 0; i < 7; i++) sum[i] += v[i];
      good++;
    }
    delay(10);
  }
  if (good == 0) {
    Serial.println("Calibration failed: no readings.");
    return;
  }
  for (int i = 0; i < 7; i++) bias[i] = sum[i] / good;
  bias[2] -= ACC_LSB;
  bias[3]  = 0;
  Serial.printf("Bias  acc: %.0f %.0f %.0f  gyro: %.0f %.0f %.0f  (%d samples)\n",
                bias[0], bias[1], bias[2], bias[4], bias[5], bias[6], good);
}

void setup() {
  Serial.begin(115200);
  while (!Serial && millis() < 3000) {}

  Wire.begin();
  Wire.setClock(400000);

  uint8_t who = readReg(0x75);
  Serial.printf("WHO_AM_I: 0x%02X %s\n", who,
                who == 0x68 ? "(OK)" : "(unexpected, check wiring or clone chip)");
writeReg(0x6B, 0x01);
  writeReg(0x1A, 0x03);
  writeReg(0x19, 0x09);
  writeReg(0x1B, 0x00);
  writeReg(0x1C, 0x00);

  delay(2000);
  calibrate();
  tick = 0;
}

void loop() {
  if (tick < PERIOD_US) return;
  tick -= PERIOD_US;

  int16_t raw[7];
  if (!readRaw(raw)) {
    Serial.println("I2C read error");
    return;
  }

  for (int i = 0; i < 7; i++) {
    float c = raw[i] - bias[i];
    filt[i] = seeded ? filt[i] + ALPHA * (c - filt[i]) : c;
  }
  seeded = true;

  Serial.printf("acc[g] %6.3f %6.3f %6.3f | gyro[dps] %6.2f %6.2f %6.2f | T %5.1fC\n",
                filt[0] / ACC_LSB,  filt[1] / ACC_LSB,  filt[2] / ACC_LSB,
                filt[4] / GYRO_LSB, filt[5] / GYRO_LSB, filt[6] / GYRO_LSB,
                filt[3] / 340.0f + 36.53f);
}
